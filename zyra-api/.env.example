# The API reads process environment variables; it does not load this file automatically.
ADDRESS=127.0.0.1:8080
DATABASE_URL=postgres://zyra:zyra@localhost:5432/zyra?sslmode=disable
# Generate a random secret of at least 32 characters before starting.
JWT_SECRET=
# Development only: explicitly create/update tables at startup.
AUTO_MIGRATE=true
# Optional bootstrap: creates this user only if the email is absent.
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=
# Explicitly select the existing active owner on non-demo first startup.
# No first-user promotion is performed. Omit once an owner exists.
OWNER_EMAIL=
# Optional local-only fixture: admin/admin. Development mode and the login flag
# are required, and ADDRESS must be a loopback IP. Never enable in production.
APP_ENV=development
DEV_ADMIN_LOGIN=false
# The root compose.yaml sets this because containers must listen on 0.0.0.0.
# Do not set it when exposing the API container directly to a public network.
DEV_ADMIN_CONTAINER=false
